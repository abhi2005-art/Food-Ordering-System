<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.com/foodmenu" xmlns="http://www.example.com/foodmenu" elementFormDefault="qualified">
    <xsd:element name="foodMenu">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="menu" type="menuType"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:complexType name="menuType">
        <xsd:sequence>
            <xsd:element name="category" type="categoryType" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="categoryType">
        <xsd:sequence>
            <xsd:element name="item" type="itemType" maxOccurs="unbounded"/>
        </xsd:sequence>
        <xsd:attribute name="name" type="xsd:string" use="required"/>
    </xsd:complexType>

    <xsd:complexType name="itemType">
        <xsd:sequence>
            <xsd:element name="name" type="xsd:string"/>
            <xsd:element name="description" type="xsd:string"/>
            <xsd:element name="price" type="xsd:decimal"/>
        </xsd:sequence>
    </xsd:complexType>
</xsd:schema>